{
  "name": "evacai",
  "version": "1.0.0",
  "description": "EvacAI — AI-powered Fire & Smoke Detection, CCTV Monitoring & Incident Management Platform",
  "private": true,
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:ai": "cd ai-service && .\\venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8000",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:server && npm run build:client",
    "create-superadmin": "npm --prefix server run create-superadmin",
    "create-management-user": "npm --prefix server run create-management-user",
    "test:auth": "npm --prefix server run test:auth",
    "test:admin": "npm --prefix server run test:admin",
    "test:floorplan": "npm --prefix server run test:floorplan",
    "test:camera": "npm --prefix server run test:camera",
    "test:incident": "npm --prefix server run test:incident",
    "test:situation": "npm --prefix server run test:situation",
    "test:e2e": "npm --prefix server run test:e2e",
    "test:ai": "ai-service\\venv\\Scripts\\python.exe ai-service\\test_ai_service.py",
    "test:manual": "ai-service\\venv\\Scripts\\python.exe ai-service\\manual_detection_test.py"
  },
  "keywords": [
    "evacai",
    "fire-detection",
    "smoke-detection",
    "cctv",
    "esp32-cam",
    "floor-plan",
    "major-project"
  ],
  "author": "EvacAI Team",
  "license": "ISC"
}
