# EvacAI Python AI Service Environment Configuration

# Service Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Backend Integration
BACKEND_API_URL=http://localhost:4000/api
AI_SERVICE_KEY=evacai_dev_secret_key_change_in_production

# Detection Settings (Milestone 6 & 7)
CONFIDENCE_THRESHOLD=0.50
COOLDOWN_SECONDS=900
FRAME_SAMPLE_INTERVAL=5

# Milestone 7: Shared Local Evidence Storage
EVACAI_EVIDENCE_DIR=../evidence
