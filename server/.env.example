# EvacAI Backend Environment Variables

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Python AI Service Integration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=evacai_dev_secret_key_change_in_production

# Firebase Admin Configuration
# Option 1: Path to service account JSON key file (relative to server directory or absolute)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option 2: Inline service account JSON string (optional alternative for deployment)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Firebase Realtime Database URL (format: https://<PROJECT_ID>-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=https://evacai-placeholder-default-rtdb.firebaseio.com

# Firebase Storage Bucket (format: <PROJECT_ID>.appspot.com)
FIREBASE_STORAGE_BUCKET=evacai-placeholder.appspot.com
